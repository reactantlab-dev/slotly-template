# Copy to .env.local only if you need to override defaults. Never commit real values.
# SQLite file. Created automatically by `npm run dev`.
DATABASE_FILE=data/slotly.db
# Better Auth: at least 32 random characters, e.g. `openssl rand -base64 32`.
# Dev and test fall back to a fixed, non-secret placeholder; production must set this.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Better Auth rate limiting (on in production builds). The test runner sets "off".
SLOTLY_AUTH_RATE_LIMIT=
# Freeze "now" for tests and demos (ISO 8601, UTC). Leave empty to use the real clock.
SLOTLY_NOW=
